# BoxOfficeX environment configuration

# Production database connection (Render will provide this)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Local fallback database (optional override)
BOXOFFICEX_LOCAL_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost/boxofficex

# Base directory override (usually leave unset)
# BOXOFFICEX_BASE_DIR=/path/to/boxofficex

# Session / admin security
BOXOFFICEX_SESSION_SECRET=replace-with-a-long-random-secret
BOXOFFICEX_HTTPS_ONLY=true

# Bootstrap owner account
BOXOFFICEX_OWNER_EMAIL=owner@boxoffice-x.com
BOXOFFICEX_OWNER_PASSWORD=replace-with-a-strong-password
